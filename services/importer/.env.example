APP_NAME=WayniImporter
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=shared-db
DB_PORT=5432
DB_DATABASE=wayni
DB_USERNAME=wayni
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=sqs

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS / LocalStack
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=bcra-files
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://localhost:4566
AWS_ENDPOINT=http://localstack:4566

# SQS
SQS_QUEUE_URL=http://localstack:4566/000000000000/debtor-events
SQS_PREFIX=http://localstack:4566/000000000000

# S3
S3_BUCKET=bcra-files

# File Ingestion
FILE_INGESTION_MODE=local

# Notification
# Log notification is ALWAYS active for observability
# NOTIFICATION_DRIVER adds an additional channel: log (default), webhook, sqs
# Examples:
#   NOTIFICATION_DRIVER=log     → only logs
#   NOTIFICATION_DRIVER=webhook → logs + webhook POST
#   NOTIFICATION_DRIVER=sqs     → logs + SQS message
NOTIFICATION_DRIVER=log
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_QUEUE_URL=http://localstack:4566/000000000000/import-notifications

VITE_APP_NAME="${APP_NAME}"
